#!/usr/bin/env bash
# Control CLI for the agentvoice daemon, in the shape Omarchy expects: the bar
# widget and Hyprland binds both shell out to this rather than knowing about
# systemd or signals.
#
#   agentvoice start|stop|toggle   the service, i.e. the switch in the panel
#   agentvoice mic                 release or re-engage the mic, service left up
#   agentvoice lock|unlock         the screen locked or unlocked; closes the mic
#                                  while locked without disturbing the above
#   agentvoice locked              is the mic closed by a lock: prints yes|no
#                                  AND exits 0|1, so `if agentvoice locked`
#                                  is correct. is-active below only prints --
#                                  it is polled by the widget twice a second,
#                                  where a nonzero exit is journal noise.
#   agentvoice interrupt           stop the reply in progress, keep listening
#   agentvoice hud-preview         sample text on the readout for 4s
#   agentvoice talk                push-to-talk pressed: listen now, or, if it
#                                  is mid-reply, stop it
#   agentvoice talk-end            push-to-talk released: that was the turn
#   agentvoice status              JSON, for scripts and the bar
#   agentvoice is-active           yes|no, for a keybind that has to branch
#   agentvoice calibrate           can this room support barge-in?
#   agentvoice monitor             live wake-word scores, for tuning
#   agentvoice voice fetch|sample|remove <voice>   the Voice page's library
#   agentvoice permit <id> allow|allow-session|deny   answer a pending permission request (an allow only from the overlay)
#   agentvoice pending             the request waiting for an answer, as JSON
#   agentvoice endpoint ...        clean, models, test, key: the endpoint editor
#   agentvoice pass TO [--from ID] < brief   pass the conversation to agent TO
#   agentvoice tasks [cancel ID]   collaboration tasks between agents
#   agentvoice crew check < lists  may the Crew map save these crew links and
#                                  this quarantine (one JSON line on stdin)
#   agentvoice tools scan [--json] the MCP servers and CLIs found on this machine
#   agentvoice skills lanes [--json] every skill on this machine, and who gets it
#   agentvoice skills import ID TO  give an agent or communal a checked copy of one
#   agentvoice notes move|copy FROM NAME TO   a note to another agent or communal,
#                                  with its past versions (combine, undo, lanes)
#   agentvoice commands [--json]   every spoken command, and the wake phrases
#   agentvoice stats [--days N] [--json] | clear   the Overview's numbers (never text)
#   agentvoice try AGENT < draft   one sentence in AGENT's voice, on a draft
#                                  personality (Agent details' Try it)
set -euo pipefail

UNIT=agentvoice.service
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agentvoice"
STATE="$RUNDIR/state"
PIDFILE="$RUNDIR/pid"

active() { systemctl --user is-active --quiet "$UNIT"; }

# What the daemon is doing right now; "off" when it is not running.
vstate() {
  if [[ -r $STATE ]] && active; then
    # The top-level state is the file's first key. Anchored there, because
    # the file also holds collaboration tasks, each with a "state" of its
    # own, and a greedy match read the last of them (Phase 15 review).
    sed -n 's/^{"state"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$STATE"
  else
    echo off
  fi
}

# SIGUSR1 and SIGUSR2 both default to terminating the process. Two ways that
# bites: a daemon installed before the interrupt existed does not catch
# SIGUSR2, and a pidfile left behind by a crash names a pid the kernel has
# since given to something else entirely. So nothing is signalled unless its
# caught-signal mask says it is listening. SigCgt is that mask, and a signal
# n sits at bit n-1.
handles() {
  local mask signo="$2"
  mask=$(awk '/^SigCgt:/{print $2}' "/proc/$1/status" 2>/dev/null) || return 1
  [[ -n $mask ]] || return 1
  (( (0x$mask >> (signo - 1)) & 1 ))
}

# The pid to signal, or nothing. Written by the daemon and removed on the way
# out -- but not on a kill -9, hence the check above.
daemon_pid() {
  local pid
  [[ -r $PIDFILE ]] || return 1
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -d /proc/$pid ]] || return 1
  printf '%s' "$pid"
}

# One-shot command to the run loop. Renamed into place so the daemon cannot
# read a half-written file.
send_command() {
  mkdir -p "$RUNDIR"
  printf '%s' "$1" > "$RUNDIR/command.tmp" && mv -f "$RUNDIR/command.tmp" "$RUNDIR/command"
}

case "${1:-status}" in
  start)
    # A start somebody asked for clears systemd's start limit first: after a
    # few quick restarts (a crash loop, or the switch flicked on and off) it
    # refuses every start until reset-failed, and the switch looked dead.
    active || { systemctl --user reset-failed "$UNIT" 2>/dev/null || true
                systemctl --user start "$UNIT"; }
    ;;
  stop)
    systemctl --user stop "$UNIT" 2>/dev/null || true
    # The unit clears this on the way out, but a hard kill would not.
    printf '{"state":"off"}' > "$STATE" 2>/dev/null || true
    ;;
  toggle)
    if active; then exec "$0" stop; else exec "$0" start; fi
    ;;
  mic)
    # Via systemd where systemd is running it, because the unit knows which
    # process is actually ours and a pidfile only claims to.
    if active; then
      systemctl --user kill -s USR1 "$UNIT"
    elif pid=$(daemon_pid) && handles "$pid" 10; then
      kill -USR1 "$pid"
    else
      echo "daemon not running" >&2
      exit 1
    fi
    ;;
  interrupt)
    # Cut the reply short. A no-op when the daemon is idle, so this is safe to
    # bind to a key you might hit at any time.
    if pid=$(daemon_pid) && handles "$pid" 12; then
      kill -USR2 "$pid"
    elif [[ -n ${pid:-} ]]; then
      echo "this daemon predates the interrupt; restart it:" >&2
      echo "  agentvoice stop && agentvoice start" >&2
      exit 1
    else
      echo "daemon not running" >&2
      exit 1
    fi
    ;;
  talk)
    # The push-to-talk key going down. Mid-reply that means "stop talking";
    # otherwise it means "listen to me now", skipping the wake word.
    # The readout's preview publishes `speaking` with "preview": true; that
    # is sample text, not a reply to stop (phase M3, Codex review). The state
    # and the flag come from one read of the file: two reads could straddle
    # the preview's end and interrupt an idle daemon.
    snap='{"state":"off"}'
    if active && [[ -r $STATE ]]; then snap=$(<"$STATE"); fi
    st=$(printf '%s' "$snap" | sed -n 's/^{"state"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
    case "$st" in
      off)                 echo "daemon not running" >&2; exit 1 ;;
      speaking)            if [[ $snap == *'"preview": true'* ]]; then
                             send_command talk
                           else exec "$0" interrupt; fi ;;
      thinking)            exec "$0" interrupt ;;
      *)                   send_command talk ;;
    esac
    ;;
  lock|unlock)
    # Tell the daemon at once rather than letting it notice on its next poll.
    # The poll is the guarantee -- it needs nothing installed and cannot be
    # forgotten -- so this is an optimisation, not the mechanism. Bind it to
    # whatever locks the screen if the couple of seconds matter to you.
    # `|| true`, because this is meant to be bound to whatever locks the
    # screen: locking must not report a failure because voice happens to be
    # off at the time.
    { active && send_command "$1"; } || true
    ;;
  locked)
    # Whether the microphone is closed because the screen is locked. For a
    # script that wants to know, and for checking this works without having
    # to lock yourself out to find out.
    #
    # The exit status is the answer, 0 locked and 1 not -- the same convention
    # as omarchy-hyprland-session-locked, which this mirrors. It printed yes
    # or no and exited 0 either way, so the obvious `if agentvoice locked`
    # read as locked always: a script guarding anything on it did nothing,
    # silently and in the unsafe direction.
    if [[ "$(vstate)" == locked ]]; then echo yes; else echo no; exit 1; fi
    ;;
  open-mic)
    # Talk without the wake word until it is closed or goes quiet
    # (openMicIdleMin). The popup's toggle; by voice, "keep listening".
    #   agentvoice open-mic on [AGENT_ID] | off
    case "${2:-}" in
      on)
        [[ ${3:-main} =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || { echo "usage: agentvoice open-mic on [AGENT_ID] | off" >&2; exit 2; }
        active || { echo "agentvoice is not running" >&2; exit 1; }
        send_command "open-mic on ${3:-main}"
        ;;
      off)
        active || { echo "agentvoice is not running" >&2; exit 1; }
        send_command "open-mic off"
        ;;
      *) echo "usage: agentvoice open-mic on [AGENT_ID] | off" >&2; exit 2 ;;
    esac
    ;;
  hud-preview)
    # The Display page's Preview button (phase M3): four seconds of sample
    # text on the readout, published through the state file so the HUD
    # draws it exactly as it draws a turn. Only over an idle readout: a turn
    # under way is the real thing, and a locked screen shows nothing.
    active || { echo "agentvoice is not running" >&2; exit 1; }
    case "$(vstate)" in
      listening|off) send_command hud-preview ;;
      locked) echo "the screen is locked; the readout shows nothing then" >&2; exit 1 ;;
      *) echo "a turn is under way; the readout is showing the real thing" >&2; exit 1 ;;
    esac
    ;;
  wake-test)
    # The Listening page's "Test my wake word": for 90s, or ten wakes, a wake
    # is counted instead of answered. Results in $RUNDIR/wake-test.json.
    #   agentvoice wake-test start|stop
    #   agentvoice wake-test auto|auto-stop
    #     synthesized names through the same engines, in a process of its
    #     own, so it never touches the microphone. Results in wake-auto.json.
    case "${2:-start}" in
      start|stop)
        if ! active; then echo "daemon not running" >&2; exit 1; fi
        send_command "wake-test-${2:-start}"
        ;;
      auto)
        mkdir -p "$RUNDIR"
        if [[ -r $RUNDIR/wake-auto.pid ]] && kill -0 "$(cat "$RUNDIR/wake-auto.pid")" 2>/dev/null; then
          echo "an automatic wake test is already running" >&2; exit 1
        fi
        REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
        [[ -x $PY ]] || { echo "no agentvoice Python at $PY; run install.sh" >&2; exit 1; }
        setsid "$PY" "$REPO/daemon/wake_auto.py" > "$RUNDIR/wake-auto.log" 2>&1 < /dev/null &
        ;;
      auto-stop)
        if [[ -r $RUNDIR/wake-auto.pid ]]; then
          pid=$(cat "$RUNDIR/wake-auto.pid")
          [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null || true
        fi
        ;;
      *) echo "usage: agentvoice wake-test start|stop|auto|auto-stop" >&2; exit 2 ;;
    esac
    ;;
  type)
    # Send an agent a message without speaking: no microphone, a wake word
    # that will not fire, or a room where you would rather not talk. The text
    # comes on stdin, never argv -- /proc/<pid>/cmdline is readable by every
    # account on the machine.
    #   echo "what's on my calendar" | agentvoice type [AGENT_ID] [--line]
    # A name at the start routes it, as it does spoken: "Sora, ...".
    agent="${2:-main}"
    [[ $agent =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || { echo "usage: agentvoice type [AGENT_ID] < text" >&2; exit 2; }
    active || { echo "agentvoice is not running" >&2; exit 1; }
    if [[ ${3:-} == --line ]]; then
      # One line, so a caller that cannot close stdin (the panel) is not
      # left waiting for an end of file.
      IFS= read -r -n 32000 text || true
    else
      [[ -t 0 ]] && echo "type the message, then ctrl-d" >&2
      text=$(head -c 32000)
    fi
    [[ -n ${text//[[:space:]]/} ]] || { echo "nothing to send" >&2; exit 2; }
    ( umask 077
      mkdir -p "$RUNDIR/typed"
      name="$(date +%s%N)-$$"
      printf '%s\n%s' "$agent" "$text" > "$RUNDIR/typed/$name.tmp" &&
        mv -f "$RUNDIR/typed/$name.tmp" "$RUNDIR/typed/$name.msg" )
    ;;
  try)
    # Agent details' Try it (phase M6): one sentence in AGENT's voice from a
    # quiet side turn with no tools, on the draft personality and
    # instructions, which arrive on stdin as one JSON line -- never argv.
    # Prints the sentence; says why not on stderr and exits 1.
    #   agentvoice try AGENT < {"personality": "...", "instructions": "..."}
    agent="${2:-}"
    [[ $agent =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || { echo "usage: agentvoice try AGENT < draft.json" >&2; exit 2; }
    active || { echo "Agent Voice is off; switch it on to try a voice" >&2; exit 1; }
    [[ "$(vstate)" != locked ]] || { echo "the screen is locked" >&2; exit 1; }
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || { echo "no agentvoice Python at $PY; run install.sh" >&2; exit 1; }
    exec "$PY" "$REPO/daemon/try_it.py" client "$agent"
    ;;
  talk-end)
    # The key coming back up ends the turn. Ignored by the daemon unless a
    # push-to-talk capture is actually open.
    active && send_command talk-end
    ;;
  permit)
    # Answer a pending permission request. The overlay calls this; a person
    # at a terminal can still say no with it, and nobody can say yes with it
    # from anywhere but the overlay (phase M7).
    #   agentvoice permit <id> allow|allow-session|deny
    # Since M7 the answer goes to the daemon over its card socket, not into a
    # file any process could write. The daemon checks who sent it: an allow
    # counts only from a process the live Omarchy shell started itself, with
    # its stdin a pipe from that shell carrying the card's one-use nonce and
    # digest -- so the nonce is read from stdin, never argv. An allow from
    # anywhere else is refused and the question is denied. `exec`, so the
    # process the daemon checks is the one the overlay started. `-I` keeps
    # the environment's PYTHON* variables out of a security check; `-B`
    # because -I also drops PYTHONDONTWRITEBYTECODE, and the check's run
    # must write nothing in the tree (found by agentvoice-deploy's fresh
    # worktree, which had no .pyc to hide it).
    id="${2:-}"; verdict="${3:-deny}"
    # The id is checked rather than trusted, as it always was.
    if [[ ! $id =~ ^[0-9a-f]{12}$ ]] || [[ ! $verdict =~ ^(allow|allow-session|deny)$ ]]; then
      echo "usage: agentvoice permit <id> allow|allow-session|deny   (id is 12 hex characters)" >&2
      exit 2
    fi
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || { echo "no agentvoice Python at $PY; run install.sh" >&2; exit 1; }
    exec "$PY" -I -B "$REPO/daemon/cards.py" answer "$id" "$verdict"
    ;;
  pending)
    # A permission request waiting for an answer, as JSON; {} when none is.
    #   agentvoice pending <id>   that exact one, so the overlay answers the
    #                             question it was summoned about
    #   agentvoice pending        the newest, for a person at a terminal
    # From the daemon since phase M7. Only the overlay's own call -- a
    # process the live shell started, its stdout a pipe back to that shell
    # -- is given the nonce an allow needs; anyone else sees the question.
    want="${2:-}"
    if [[ -n $want && ! $want =~ ^[0-9a-f]{12}$ ]]; then echo '{}'; exit 0; fi
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || { echo '{}'; exit 0; }
    if [[ -n $want ]]; then
      exec "$PY" -I -B "$REPO/daemon/cards.py" show "$want"
    fi
    exec "$PY" -I -B "$REPO/daemon/cards.py" show
    ;;
  calibrate)
    # Whether the user can be heard over the speaker is a property of the
    # room, not of the code, so it is measured rather than assumed.
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    # The path goes through the environment, not through the source: a repo
    # checked out somewhere with an apostrophe in the name would otherwise
    # end the string literal and break the program.
    AGENTVOICE_DAEMON_DIR="$REPO/daemon" exec "$PY" -c \
      'import os, sys; sys.path.insert(0, os.environ["AGENTVOICE_DAEMON_DIR"]); import barge; sys.exit(barge.calibrate())'
    ;;
  monitor)
    # Live wake-word scores. Safe to run alongside the daemon: PipeWire allows
    # several readers on one microphone.
    shift
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY="$REPO/bench/.venv/bin/python"
    exec "$PY" "$REPO/daemon/monitor.py" "$@"
    ;;
  voice)
    # The Voice page's library: fetch, hear or remove one Piper voice.
    #   agentvoice voice fetch <voice>          download, checked against models.lock
    #   agentvoice voice sample <voice> [speed] about a minute of speech in it
    #   agentvoice voice remove <voice>         delete it (not the default)
    shift
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    exec "$PY" "$REPO/daemon/voices.py" "$@"
    ;;
  pass)
    # Pass the conversation to another agent (merged plan, Phase 15). The
    # brief comes on stdin, never argv. Says on stderr that the chat goes
    # with it, and only then sends; the daemon checks again when it starts.
    #   agentvoice pass TO [--from ID] [--chat ID] < brief
    active || { echo "agentvoice is not running" >&2; exit 1; }
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    shift
    exec "$PY" "$REPO/daemon/collab.py" pass "$@"
    ;;
  tasks)
    # Collaboration tasks: open ones and the last few finished.
    #   agentvoice tasks [--json]
    #   agentvoice tasks cancel ID
    if [[ ${2:-} == cancel ]]; then
      [[ ${3:-} =~ ^[0-9a-f]{12,32}$ ]] || { echo "usage: agentvoice tasks cancel ID" >&2; exit 2; }
      active || { echo "agentvoice is not running" >&2; exit 1; }
      send_command "task-cancel $3"
      exit 0
    fi
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    shift
    exec "$PY" "$REPO/daemon/collab.py" tasks "$@"
    ;;
  crew)
    # The Crew map's validator (phase M9): one JSON line on stdin,
    # {"crewLinks": [...], "crewQuarantine": [...]}, judged with the
    # daemon's own rules against the agents and the lists saved now. Reads
    # the settings only; no daemon needed, nothing written.
    #   agentvoice crew check < lists
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    shift
    exec "$PY" "$REPO/daemon/collab.py" crew "$@"
    ;;
  tools)
    # The tools found on this machine (phase M10): MCP servers in Claude
    # Code's and Codex's own settings, and CLIs on PATH. Reads files only;
    # never starts a tool, never prints a secret value.
    #   agentvoice tools scan [--json] [--rescan]
    #   agentvoice tools dismiss AGENT     hide AGENT's "now off" notice
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    shift
    exec "$PY" "$REPO/daemon/tooldetect.py" "$@"
    ;;
  skills)
    # Every skill on this machine and who gets it (phase M11): the agents'
    # own, the communal ones, and the ones Claude Code and Codex find by
    # themselves. Reads files only. `import` gives an agent (or communal) a
    # checked copy of one found outside Agent Voice; the original is never
    # changed. Asked about when an agent runs it (the orders guard).
    #   agentvoice skills lanes [--json]
    #   agentvoice skills import SOURCE_ID AGENT_ID|communal
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    shift
    exec "$PY" "$REPO/daemon/skillscan.py" "$@"
    ;;
  notes)
    # Moving, copying and combining notes (phase M13): a note goes with its
    # past versions and its record entry (rev, author, taint, lock). Into
    # Communal, out of a quarantined agent, or a note that may hold text from
    # web pages needs --confirm. Only the person does this: an agent running
    # it is asked at every level (the orders guard). One folder's notes are
    # `agentvoice agents notes TARGET ...`.
    #   agentvoice notes lanes [--json]          every folder's notes
    #   agentvoice notes move|copy FROM NAME TO [--confirm]
    #   agentvoice notes combine TARGET INTO NAME NAME...
    #   agentvoice notes undo OP | history [--json]
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    shift
    exec "$PY" "$REPO/daemon/notemoves.py" "$@"
    ;;
  chats)
    # Saved conversations (saveChats). The daemon holds which chat each
    # agent is in, so continuing or starting one is a command to it; the
    # rest change the files directly, under the same lock the daemon takes.
    #   agentvoice chats [list]          one line per chat
    #   agentvoice chats show ID         as Markdown
    #   agentvoice chats rename ID [TITLE] / pin ID / unpin ID / delete ID
    #                                    (no TITLE: one line on stdin, M18)
    #   agentvoice chats delete --all    every saved chat; prints how many (M18)
    #   agentvoice chats stats [--json]  where they are, how many, how big
    #   agentvoice chats last --json     each agent's newest saved chat, ids only (M21)
    #   agentvoice chats search [--agent ID] [--json]   best matches first;
    #                                    the words on stdin, never argv (M18);
    #                                    agent:NAME before:DATE after:DATE
    #                                    among them filter (M19)
    #   agentvoice chats export ID [DIR] write it as Markdown, print where
    #   agentvoice chats continue ID [AGENT]  its agent's (or AGENT's, when
    #                                    the chat is shared with it) next
    #                                    turn goes into it
    #   agentvoice chats share ID AGENT / unshare ID AGENT   who besides its
    #                                    owner may be given the chat
    #   agentvoice chats new [AGENT]     that agent (main if none) starts afresh
    case ${2:-list} in
      continue)
        [[ ${3:-} =~ ^[0-9a-f]{16}$ ]] || { echo "usage: agentvoice chats continue ID [AGENT]" >&2; exit 2; }
        [[ -z ${4:-} || ${4:-} =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || { echo "usage: agentvoice chats continue ID [AGENT]" >&2; exit 2; }
        active || { echo "agentvoice is not running" >&2; exit 1; }
        if [[ -n ${4:-} ]]; then
          # Refused here, where it was asked, when the chat is neither the
          # agent's nor shared with it; the daemon checks again.
          REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
          PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
          "$PY" "$REPO/daemon/chats.py" may-continue "$3" "$4" || exit 1
          send_command "chat-continue $3 $4"
        else
          send_command "chat-continue $3"
        fi
        ;;
      new)
        [[ ${3:-main} =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || { echo "usage: agentvoice chats new [AGENT_ID]" >&2; exit 2; }
        active || { echo "agentvoice is not running" >&2; exit 1; }
        send_command "chat-new ${3:-main}"
        ;;
      *)
        REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
        PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
        shift
        exec "$PY" "$REPO/daemon/chats.py" "$@"
        ;;
    esac
    ;;
  agents)
    # Agent folders and the communal folder (merged plan, Phase 9). Text
    # arrives on stdin, never as an argument: argv is readable by every
    # account, and these files are what the agents are told.
    #   agentvoice agents list [--json] | show TARGET [--json]
    #   agentvoice agents create ID | trash ID < settings.json
    #   agentvoice agents restore NAME | trash-list [--json]
    #   agentvoice agents write TARGET FILE [--base STAMP] < text
    #   agentvoice agents history TARGET FILE [--json]
    #   agentvoice agents revert TARGET FILE [VERSION] | ack TARGET FILE
    #   agentvoice agents notes TARGET list|show|write|lock|unlock|history|
    #                              version|restore|folder [NAME [VERSION]]
    #   agentvoice agents traits get ID | set ID [--base STAMP] | apply
    #                              the trait chips' line (JSON on stdin)
    #   agentvoice agents templates [--json]   starters for an empty box
    #   agentvoice agents runinfo ID [--json]  how it runs: command line (redacted),
    #                              session, servers, log lines, permission decisions
    #   agentvoice agents duplicate ID         a copy, switched off, no grants (JSON)
    #   agentvoice agents reset ID < entry     back to defaults, old one to the trash
    #   agentvoice agents unreset NAME         put a reset agent back from the trash
    #   agentvoice agents flags check PROGRAM < JSON list   would each extra flag pass
    #   agentvoice agents env ID list [--json] | set NAME [--line] < value | unset NAME | clear
    #                              an agent's environment variables; never prints a value
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    shift
    exec "$PY" "$REPO/daemon/agentfs.py" "$@"
    ;;
  endpoint)
    # The settings page's endpoint helpers (plan 7b). A key goes in on
    # stdin, never as an argument: argv is readable by every account.
    #   agentvoice endpoint clean URL          the URL that will be used
    #   agentvoice endpoint models URL         JSON list of model names
    #   agentvoice endpoint test URL MODEL     JSON: reachable, first word, error
    #   agentvoice endpoint key set|show|clear URL
    #   agentvoice endpoint presets
    shift
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    exec "$PY" "$REPO/daemon/endpoints.py" "$@"
    ;;
  history)
    # This session's conversation, which the daemon keeps beside the state
    # file for the conversation view: tmpfs, 0600, gone at logout.
    #   agentvoice history         print it
    #   agentvoice history clear   delete it -- the overlay's Clear button
    H="$RUNDIR/history.jsonl"
    if [[ ${2:-} == clear ]]; then rm -f "$H"; exit 0; fi
    if [[ ! -s $H ]]; then echo "nothing yet this session" >&2; exit 0; fi
    # -R and fromjson?, so one damaged line skips itself rather than ending
    # the listing. Control characters are stripped: a reply is model output,
    # and printed raw to a terminal it can carry escape sequences.
    jq -rR 'fromjson? | def clean: gsub("[\u0000-\u0008\u000b-\u001f\u007f]"; "");
      (if .new then "-- new conversation --\n" else "" end)
      + ((.at // 0 | floor | strflocaltime("%H:%M")) + "  you: " + (.transcript // "" | clean))
      + "\n       " + (.agent // "agent") + ": " + (.reply // "" | clean)
      + (if (.error // "") != "" then "  [failed: " + .error + "]" else "" end)
      + (if .stopped then "  [stopped]" else "" end) + "\n"' "$H"
    ;;
  stats)
    # The Overview's numbers (master plan M21): per-day counts and timings,
    # never anything said. Reads the files; no daemon needed.
    #   agentvoice stats [--days N] [--json]   today and the last N days (7)
    #   agentvoice stats clear                 delete every day; prints how many
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    shift
    exec "$PY" "$REPO/daemon/stats.py" "$@"
    ;;
  commands)
    # Every spoken command (phase M4): its phrases, what it does, where in a
    # sentence it counts, what it says when it fires there, and the agents'
    # wake phrases. Reads the settings only; no daemon needed.
    #   agentvoice commands [--json]
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY=python3
    shift
    exec "$PY" "$REPO/daemon/voice_commands.py" "$@"
    ;;
  status)
    if [[ -r $STATE ]] && active; then cat "$STATE"; else echo '{"state":"off"}'; fi
    ;;
  is-active)
    active && echo yes || echo no
    ;;
  *)
    echo "usage: agentvoice [start|stop|toggle|mic|lock|unlock|locked|talk|talk-end|type|try|interrupt|hud-preview|monitor|calibrate|voice|permit|pending|history|chats|pass|tasks|crew|tools|skills|notes|agents|endpoint|open-mic|commands|stats|wake-test|status|is-active]" >&2
    exit 2
    ;;
esac
